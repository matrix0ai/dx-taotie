{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "issuegraph codex-hook PostCompact",
            "statusMessage": "Scheduling IssueGraph context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "issuegraph codex-hook PreCompact",
            "statusMessage": "Checking IssueGraph context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "issuegraph codex-hook SessionStart",
            "statusMessage": "Loading IssueGraph context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "issuegraph codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing IssueGraph context",
            "type": "command"
          }
        ]
      }
    ]
  }
}

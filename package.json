{
  "name": "@taotie/monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"pnpm --filter @taotie/server dev\" \"pnpm --filter @taotie/client dev\"",
    "dev:lan": "concurrently --kill-others-on-fail --names server,client \"pnpm --filter @taotie/server dev\" \"pnpm --filter @taotie/client dev --host\"",
    "test": "pnpm test:bootstrap && pnpm test:hooks && turbo run test",
    "test:bootstrap": "node --test scripts/dev-bootstrap.test.mjs",
    "test:hooks": "node --test .claude/hooks/contributing-check.test.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint --filter=@taotie/server --filter=taotie",
    "build:server": "pnpm --filter @taotie/server build",
    "test:migrations": "pnpm --filter @taotie/server test:migrations",
    "desktop:dev": "pnpm --filter @taotie/client build && pnpm --filter taotie-desktop dev",
    "desktop:dist": "pnpm --filter @taotie/client build && pnpm --filter taotie-desktop dist",
    "desktop:dist:mac:x64": "pnpm --filter @taotie/client build && pnpm --filter taotie-desktop dist:mac:x64",
    "desktop:dist:win": "pnpm --filter @taotie/client build && pnpm --filter taotie-desktop dist:win",
    "desktop:dist:linux": "pnpm --filter @taotie/client build && pnpm --filter taotie-desktop dist:linux",
    "db:migration:up": "pnpm --filter @taotie/server db:migration:up",
    "db:migration:down": "pnpm --filter @taotie/server db:migration:down",
    "db:migration:fresh": "pnpm --filter @taotie/server db:migration:fresh",
    "db:migration:status": "pnpm --filter @taotie/server db:migration:status",
    "db:migration:create": "pnpm --filter @taotie/server db:migration:create"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jsdom": "^27.4.0",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "volta": {
    "node": "22.23.3"
  }
}
